# Generates a C++ source file with every templates/*.html as a string, so the
# templates are compiled into app.cgi. Run by the build:
#   cmake -DTEMPLATE_DIR=<dir> -DOUTPUT=<file.cpp> -P embed_templates.cmake

file(GLOB templates "${TEMPLATE_DIR}/*.html")
list(SORT templates)

set(delimiter "jctpl")
set(code "// Generated by cmake/embed_templates.cmake from templates/*.html. Do not edit.\n")
string(APPEND code "#include \"presentation/templates/template_sources.h\"\n\n")
string(APPEND code "namespace {\n\nstruct Entry {\n    std::string_view name;\n    std::string_view source;\n};\n\n")
string(APPEND code "constexpr Entry kTemplates[] = {\n")

foreach(path IN LISTS templates)
    get_filename_component(name "${path}" NAME_WE)
    if(NOT name MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Template names must be lowercase identifiers: ${path}")
    endif()
    file(READ "${path}" text)
    string(FIND "${text}" ")${delimiter}\"" collision)
    if(NOT collision EQUAL -1)
        message(FATAL_ERROR "Template contains the raw-string delimiter: ${path}")
    endif()
    string(APPEND code "    {\"${name}\", R\"${delimiter}(${text})${delimiter}\"},\n")
endforeach()

string(APPEND code "};\n\n}  // namespace\n\n")
string(APPEND code "std::optional<std::string_view> templateSource(std::string_view name)\n{\n")
string(APPEND code "    for (const Entry& entry : kTemplates) {\n        if (entry.name == name) {\n")
string(APPEND code "            return entry.source;\n        }\n    }\n    return std::nullopt;\n}\n")

# Only rewrite when the content changes, to avoid needless recompilation.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL code)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${code}")
